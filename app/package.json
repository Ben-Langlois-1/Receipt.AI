{
  "name": "receipt-ai",
  "private": true,
  "version": "1.0.0-rc.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "stage:desktop": "node scripts/stage-resources.cjs",
    "package:linux": "npm run build && node scripts/package-linux.cjs",
    "package:dir": "npm run build && electron-builder --config electron-builder.cjs --dir",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:real-model": "node --experimental-strip-types --test tests/real-model-advisor.test.ts",
    "test:desktop": "node tests/e2e/desktop.cjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "oxlint": "^1.81.0",
    "playwright": "1.65.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "main": "desktop/main.cjs",
  "desktopName": "edu.receiptai.desktop",
  "description": "Private desktop financial analysis with offline local AI",
  "author": {
    "name": "Receipt.AI project team"
  },
  "license": "UNLICENSED",
  "homepage": "https://example.invalid/receipt-ai"
}
